#include <EEPROM.h>

int yellowButtonPin=12;
int blueButtonPin=8;
int buttonYellow;
int buttonBlue;
int i=0;
int dt=250;
int buzzPin=13;
int bluePin=3;
int yellowPin=4;
int redPin=7;
int fanPin=10;
//* for reading the temperature *//
int thermistorPin=A0;
int dt2=500;
float temperature;
float current;
float voltageThermistor;
float thermistorResistance;
float voltageResistor;
float temperatureFahrenheit;
int threeWatPin=9;
float temperatureMax=95;
float temperatureWarning=90;
bool overheated = false;
bool warningPlayed=false;
int temperature100=100;
bool alarmPlayed=false;
bool firstTime=true;


void setup() {
  // put your setup code here, to run once:
Serial.begin(9600);
pinMode(yellowButtonPin,INPUT_PULLUP);
pinMode(blueButtonPin,INPUT_PULLUP);
pinMode(buzzPin,OUTPUT);
pinMode(bluePin,OUTPUT);
pinMode(yellowPin,OUTPUT);
pinMode(redPin,OUTPUT);
pinMode(threeWatPin,OUTPUT);
pinMode(fanPin,OUTPUT);
//* for reading the temperature *//
pinMode(thermistorPin,INPUT);
Serial.begin(9600);

i=EEPROM.read(0);
analogWrite(threeWatPin, i);

}

void loop() {
  // put your main code here, to run repeatedly:
//* for reading the temperature; need to replace 3380 for actual beta constant later *//
voltageResistor=(5./1023.)*analogRead(thermistorPin);
voltageThermistor=5.-voltageResistor;
current=(voltageResistor/10000.);
thermistorResistance=(voltageThermistor/current);
temperature=1/(log(thermistorResistance/10000.)/3380.+1./298.15);
temperatureFahrenheit=(temperature-273.15)*(9./5.)+32.;
Serial.print("The Temperature is: ");
Serial.print(temperatureFahrenheit);
Serial.println("°F");
delay(dt2);

buttonYellow=digitalRead(yellowButtonPin);
buttonBlue=digitalRead(blueButtonPin);

if (i == 0 && !overheated && !firstTime){
  digitalWrite(bluePin,LOW);
  digitalWrite(yellowPin,LOW);
  digitalWrite(redPin,LOW);
  analogWrite(threeWatPin,0);  

}

  if(temperatureFahrenheit<=temperatureWarning){
  firstTime=true;
  warningPlayed=false;
  alarmPlayed=false;
  overheated=false;
  digitalWrite(fanPin,LOW);
  digitalWrite(bluePin,HIGH);
  digitalWrite(yellowPin,LOW);
  digitalWrite(redPin,LOW);
  analogWrite(threeWatPin,i);


  }
 if(temperatureFahrenheit>temperatureWarning && temperatureFahrenheit<temperatureMax){
  Serial.println("LED Status: Heating Up");
  Serial.println(" ⚠️ WARNING ⚠️ ");
  digitalWrite(bluePin,LOW);
  digitalWrite(yellowPin,HIGH);
  digitalWrite(redPin,LOW);
  if(!warningPlayed){
    tone(buzzPin, 1500);
    delay(150);
    noTone(buzzPin);
    delay(100);
    tone(buzzPin, 1500);
    delay(150);
    noTone(buzzPin);
    warningPlayed = true;
  }
  analogWrite(threeWatPin,i);

  }

 if(temperatureFahrenheit>=temperatureMax && temperatureFahrenheit<=temperature100){
  overheated=true;
  Serial.println(" ⚠️ WARNING ⚠️ : LED is at UNSAFE temperature levels.");
  Serial.println("🚫 DO NOT TOUCH LED 🚫");
  digitalWrite(bluePin,LOW);
  digitalWrite(yellowPin,LOW);
  digitalWrite(redPin,HIGH);
  analogWrite(threeWatPin,i);
  //* alarm sounds *//
  if(!alarmPlayed){
  for(int f = 1000;f<=3000;f=f+20){
  tone(buzzPin,f);
  delay(5);}
  
  for(int f = 3000;f>=1000;f=f-20){
  tone(buzzPin,f);
  delay(5);
  
  }
  }
  }

if(temperatureFahrenheit>temperature100){
  firstTime=false;
  overheated=true;
  alarmPlayed=true;
  warningPlayed=true;
  noTone(buzzPin);
  analogWrite(threeWatPin,0);
  i=0;
  EEPROM.update(0,i);
  Serial.println("LED IS TOO HOT");
  Serial.println("EMERGENCY SHUTDOWN");
  Serial.println("FAN INITIATED");
  digitalWrite(fanPin,HIGH);
  digitalWrite(bluePin, LOW);
  digitalWrite(yellowPin, LOW);
  digitalWrite(redPin, HIGH);
  return;

  }


if (buttonYellow==0){
  i=i+20;

  if (i>255){
  i=255;

  }
  if (i <= 170 && i != 0) {

    tone(buzzPin, 1000);
    delay(100);
    noTone(buzzPin);
    delay(dt);}

  if (i > 170 && i != 255) {

    tone(buzzPin, 2000);
    delay(100);
    noTone(buzzPin);
    delay(dt);
    }

   if (i >= 255) {

    tone(buzzPin, 3500);
    delay(100);
    noTone(buzzPin);
    delay(dt);
    }}
  


  EEPROM.update(0,i);

  float percent=(i/255.)*100.;
  Serial.println("----------------------------------------");
  Serial.print("Brightness: ");
  Serial.print(percent,2);
  Serial.println("%");
  delay(dt);



if (buttonBlue==0){
  i=i-20;
  if (i<0){
    i=0;
  }
  if (i >= 0) {
  tone(buzzPin, 1000);
  delay(100);
  noTone(buzzPin);
  delay(dt);
  }

  if (i==0 && !overheated && !firstTime){
  digitalWrite(bluePin,LOW);
  digitalWrite(yellowPin,LOW);
  digitalWrite(redPin,LOW);
  }
}

  EEPROM.update(0,i);

Serial.println("----------------------------------------");
delay(dt);

}
